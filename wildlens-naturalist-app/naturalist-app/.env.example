# Copy this file to ".env" and fill in your values.

# Get a free key at https://my.plantnet.org/ (My Account -> API access)
# Leave blank to run the app in DEMO MODE with realistic mock results
# (useful for local testing / demos without signing up for anything).
PLANTNET_API_KEY=

# Which PlantNet project/flora to match against. "all" works worldwide.
# Other options: k-world-flora, weurope, canada, useast, etc.
PLANTNET_PROJECT=all

# Port the server listens on
PORT=3000
